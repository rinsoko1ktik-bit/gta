-- مثال سكربت لـ zokii mod menu
-- يتحط في /data/zokii/scripts/
local ticks = 0

function on_start()
  notify("example.lua started")
  god(true)
end

function on_tick()
  ticks = ticks + 1
  if ticks % 600 == 0 then notify("still running...") end
end

function on_stop()
  god(false)
  notify("example.lua stopped")
end
-- الدوال المتاحة: notify(msg) god(bool) wanted(n) teleport(x,y,z) set_time(h,m)
